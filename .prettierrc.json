{
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "plugins": ["@trivago/prettier-plugin-sort-imports"],
    "importOrder": [
      "^react",
      "<THIRD_PARTY_MODULES>",
      "^redux/(.*)$",
      "^hooks/(.*)$",
      "^pages/(.*)$",
      "^@consta/uikit/(.*)$",
      "^components/(.*)$",
      "(?=^./.*)(?!.*(.module.scss|helper)$).*",
      "(?=^../.*)(?!.*(.module.scss|helper)$).*",
      "^uikit/(.*)$",
      "^@consta/icons/(.*)$",
      "^utils/(.*)$",
      "^helpers/(.*)$",
      "^config/(.*)$",
      "^models/(.*)$",
      "^shared/(.*)$",
      "(.*)helper$",
      "(.*).module.scss$",
      "(.*).scss$",
      "(.*).css$",
      "^assets/img/(.*)$"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true
  }
  